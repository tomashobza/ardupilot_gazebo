# Iris is X frame
FRAME_CLASS          1
FRAME_TYPE          1

# IRLOCK FEATURE
RC8_OPTION          39
PLND_ENABLED        1
PLND_TYPE           3

# SONAR FOR IRLOCK
SIM_SONAR_SCALE     10
RNGFND1_TYPE        1
RNGFND1_SCALING     10
RNGFND1_PIN         0
RNGFND1_MAX_CM      5000

# Gimbal mount configuration
MNT1_TYPE           1          # Standard gimbal
MNT1_PITCH_MAX      90         # Maximum pitch angle
MNT1_PITCH_MIN      -90        # Minimum pitch angle
MNT1_ROLL_MAX       90         # Maximum roll angle
MNT1_ROLL_MIN       -90        # Minimum roll angle
MNT1_DEFLT_MODE     3          # Set default mode to MAVLink targeting
MNT1_RC_RATE        90         # Maximum rotation rate in degrees/second

# Gimbal roll and pitch RC assignments
RC9_OPTION          212        # Mount1 Roll
RC10_OPTION         213        # Mount1 Pitch

# Gimbal servo function assignments
SERVO5_FUNCTION     8          # Mount1 Roll 
SERVO6_FUNCTION     7          # Mount1 Pitch

HOME_RESET_ALT  -1